{
  "name": "skate-pose-api",
  "version": "0.1.0",
  "private": true,
  "description": "API que recebe vídeos de skate, guarda metadados e raw no S3 e gera vídeo com esqueleto de pose",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "inspect": "tsx src/scripts/inspect.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1167.0",
    "@aws-sdk/client-dynamodb": "^3.1167.0",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@aws-sdk/lib-dynamodb": "^3.1167.0",
    "@aws-sdk/lib-storage": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@napi-rs/canvas": "^1.1.1",
    "@smithy/node-http-handler": "^4.14.2",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
