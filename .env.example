PORT=3000
NODE_ENV=development

S3_BUCKET=skate-videos
S3_FORCE_PATH_STYLE=true
DDB_TABLE=videos
SQS_QUEUE_NAME=video-processing
SQS_DLQ_NAME=video-processing-dlq
SQS_MAX_RECEIVE_COUNT=3

# Cognito: em produção defina os dois IDs; em dev a API cria/acha o pool pelo nome.
COGNITO_POOL_NAME=skate-pose
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

MAX_UPLOAD_MB=500
WORK_DIR=./tmp

# thunder (1 pessoa, mais preciso) | lightning (1 pessoa, mais rápido) | multipose (até 6)
POSE_MODEL=thunder
POSE_MIN_SCORE=0.3
